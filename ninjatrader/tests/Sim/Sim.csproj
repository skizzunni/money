<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles Strategies/MnqNoiseMomentum.cs against NinjaTraderStubs.cs (a stand-in for the parts of NinjaTrader 8's
       API it uses) and runs it on a bar file with a simple fill model, for tests/test_ninjatrader.py. C# 5. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NinjaTraderStubs.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="../../AddOns/MnqNoiseEngine.cs" />
    <Compile Include="../../Strategies/MnqNoiseMomentum.cs" />
    <Compile Include="../../Strategies/MnqMomentumRunner.cs" />
    <Compile Include="../../Strategies/MnqMomentumC.cs" />
    <Compile Include="../../Strategies/MnqCandidateD.cs" />
    <Compile Include="../../Strategies/MnqFomcDrift.cs" />
    <Compile Include="../../Strategies/MnqNoiseV38.cs" />
  </ItemGroup>
</Project>

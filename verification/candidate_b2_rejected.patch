diff --git a/tests/test_ninjatrader.py b/tests/test_ninjatrader.py
index 76f64ad..1b9fadd 100644
--- a/tests/test_ninjatrader.py
+++ b/tests/test_ninjatrader.py
@@ -1339,3 +1339,28 @@ def test_breakout_shorts_off_removes_only_the_breakout_shorts(sim, tmp_path, see
     off = named({"UseBreakout": True, "BreakoutShorts": False})
     assert any(x[-1] == "W Short" for x in base)
     assert off == [x for x in base if x[-1] != "W Short"]
+
+
+@pytest.mark.parametrize("seed", [3, 5])
+def test_second_lock_step(sim, tmp_path, seed):
+    """Candidate B2 (docs/DEVELOPMENT.md): off (0, the default) the trades are the control's exactly; at 2 / 25, once a
+    position's best point reaches 50 points (2 max losses of 4 MNQ at $200) by a bar's close, every later stop exit
+    is at entry + 25 or better (less a tick of slippage), and the change does alter trades."""
+    bars = rth_minutes(40, seed)
+    base, _, _, _ = run_sim(sim, bars, tmp_path, minutes=1, breakout=False, RoundPrices=False)
+    off, _, _, _ = run_sim(sim, bars, tmp_path, minutes=1, breakout=False, RoundPrices=False, SecondLockAt=0)
+    on, _, _, printed = run_sim(sim, bars, tmp_path, minutes=1, breakout=False, RoundPrices=False, SecondLockAt=2,
+                                SecondLockPlus=25)
+    assert off == base and on != base
+    assert any("SecondLock 2/25" in p for p in printed if p.startswith("MNQ settings:"))
+    h, lo = bars.high.to_numpy(float), bars.low.to_numpy(float)
+    checked = 0
+    for d, eb, en, xb, ex, why, _ in on:
+        d, eb, xb, en, ex = int(d), int(eb), int(xb), float(en), float(ex)
+        if why != "Stop loss" or xb <= eb:
+            continue
+        best = (h[eb:xb].max() - en) if d > 0 else (en - lo[eb:xb].min())
+        if best >= 50:
+            checked += 1
+            assert d * (ex - en) >= 25 - 0.25 - 1e-9, (d, eb, en, xb, ex, best)
+    assert checked, "some trades reached the second step on these bars"

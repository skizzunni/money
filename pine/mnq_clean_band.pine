//@version=6
// MNQ Clean Noise-Band: the user's "Clean Noise-Band Momentum (Prop Version)" spec with the changes that keep a 50K
// account with the $2,000 trailing floor (docs/STRATEGY_SEARCH.md, sections 1-97). The same rules as
// ninjatrader/Strategies/MnqCleanBand.cs; research/zoo/strats.py is the reference both are tested against.
// 5-minute MNQ chart with extended hours (the news rule reads the 08:30 bar). Every half hour from 10:00 to 14:00:
//   * noise area: sigma = the mean over the last 14 complete sessions of |close at that time / the 09:30 open - 1|
//     (over those with that bar, at least 10 of them: docs 162, a missing bar keeps the check on);
//     upper = max(open, prior close) x (1 + sigma), lower = min(...) x (1 - sigma);
//   * flat: LONG when the close is above upper and above the 20-session average of closes, at least 65% up the day's
//     range, and (after 10:00) the day not already 1.1 usual ranges up from its open; SHORT mirrored;
//   * stop: the tighter of the band (or VWAP) and $200 a contract from the expected fill; moved at each check, never
//     looser; back at or past it: out at market. Take profit at 2.5 x $200; once up 0.4 x $200 the stop goes to the
//     entry + 2 points, once up 1.5 x $200 to the entry + 0.5 x $200; out at 15:55 (the half days, the Friday after
//     Thanksgiving and Christmas Eve: at 13:10; a trade still open after any other early close: on the next bar);
//   * a close 1.5 sigma or more past the band trades one contract more (at most "Most contracts");
//   * no new entry once the day is down $600; 1 / 2 / 3 contracts from +$0 / +$2,000 / +$3,500;
//   * gap trade: a gap of 0.6x the 14-session average whose 09:30 bar moves its way by 3% of the average range (and
//     whose range is not over 1.75x the last 14 sessions' 09:30 bars), in at 09:35, the stop at the 09:30 open (at
//     most 30 points), out at 09:55;
//   * news days (the 08:30 volume against 08:20-08:29): 2-3x no trades, 6x and up a contract more;
//   * the cushion guard: under $1,500 above the trailing floor, 1 contract and a day stop of a quarter of the cushion;
//     under $1,000, only band entries 1.5 sigma past the band (and the gap trade).
// margin_long / margin_short 0: a futures account posts margin, not the contract's full value. TradingView's default
// (100% of the contract's value) refused every order once the size reached 2 MNQ (about $107K of contracts): the trades
// stopped (the user's chart, 2026-11-24).
strategy("MNQ Clean Noise-Band", overlay = true, initial_capital = 50000, default_qty_type = strategy.fixed,
     default_qty_value = 1, pyramiding = 0, margin_long = 0, margin_short = 0,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62, slippage = 1)

const string TZ = "America/New_York"
const int NCH = 11   // the checks 10:00, 10:30, ..., 15:00

trendDays = input.int(20, "Trend filter: sessions in the average of closes (0 = off)", minval = 0, maxval = 100)
sigMin = input.int(10, "Sigma needs at least this many of the 14 sessions (14 = all, as before)", minval = 1, maxval = 14)
hardStop = input.float(200, "Hard stop, $ a contract", minval = 1)
beAt = input.float(0.4, "Break-even once up this many hard stops (0 = off)", minval = 0, step = 0.1)
bePlus = input.float(2, "Break-even stop: points past the entry", minval = 0, step = 0.25)
ladAt = input.float(1.5, "Second stop step once up this many hard stops (0 = off)", minval = 0, step = 0.25)
ladLock = input.float(0.5, "Second stop step: the stop this many hard stops past the entry", minval = 0, step = 0.1)
tpAt = input.float(2.5, "Take profit at this many hard stops (0 = off)", minval = 0, step = 0.1)
lastEntry = input.int(840, "Last entry check, minutes from midnight New York (840 = 14:00)", minval = 600, maxval = 900)
maxTrades = input.int(9, "Most trades a day", minval = 1, maxval = 20)
vwapStop = input.bool(true, "The stop is also never looser than VWAP")
vwapEntry = input.bool(false, "Entries also need the close on VWAP's side")
maxMove = input.float(1.1, "No entry once the day has moved this many usual ranges its way (0 = off)", minval = 0, step = 0.1)
rangePos = input.float(0.65, "Entry close at least this far up the day's range (long; short mirrored; 0 = off)", minval = 0, maxval = 1, step = 0.05)
dayStop = input.float(600, "Day stop: no new entry once the day is down $ (0 = off)", minval = 0)
cushionGuard = input.float(1500, "Cushion guard: below this $ above the floor, 1 contract and a smaller day stop (0 = off)", minval = 0)
guardShare = input.float(0.25, "Cushion guard: the day stop as this share of the cushion", minval = 0.05, maxval = 1, step = 0.05)
trailDD = input.float(2000, "The account's trailing drawdown $", minval = 100)
highestBal = input.float(0, "Highest end-of-day balance so far $ (0 = the start balance)", minval = 0)
strongBelow = input.float(1000, "Cushion guard: below this $ above the floor, only strong breaks and the gap trade (0 = off)", minval = 0)
strongStretch = input.float(1.5, "Cushion guard: a strong break is this many sigmas past the band", minval = 0, step = 0.25)
maxQty = input.int(3, "Most contracts", minval = 1, maxval = 3)
fixedQty = input.int(0, "Fixed contracts (0 = the profit steps; any other number trades that many from the start)", minval = 0, maxval = 50)
stretchAdd = input.float(1.5, "One more contract when the entry closes this many sigmas past the band (0 = off)", minval = 0, step = 0.25)
step2 = input.float(2000, "2 contracts from this profit $", minval = 0)
step3 = input.float(3500, "3 contracts from this profit $", minval = 0)
startProfit = input.float(0, "Profit already made at the start $")
gapLeg = input.bool(true, "Gap trade (09:35-09:55)")
gapFrom = input.float(0, "Gap trade only from this profit $ (0 = always)")
gapK = input.float(0.6, "Gap at least this many 14-session average gaps", minval = 0, step = 0.1)
gapCap = input.float(30, "Gap stop at most this many points", minval = 1)
gapBody = input.float(0.03, "Gap: the 09:30 bar moves its way at least this x the average range", minval = 0, step = 0.01)
gapMaxBar = input.float(1.75, "Gap: no trade when the 09:30 bar's range is over this x its 14-session average (0 = off)", minval = 0, step = 0.25)
blockHole = input.bool(true, "No trading when the chart's history has a hole")
newsDays = input.bool(true, "News days (needs extended hours: the 08:30 volume)")
newsBig = input.float(6, "Big news: a contract more from this 08:30 volume spike (x)", minval = 1)
newsSkipLo = input.float(2, "Mild news: no trades from this spike (x)", minval = 0)
newsSkipHi = input.float(3, "Mild news: ... up to this spike (x)", minval = 0)

pv = syminfo.pointvalue
tk = syminfo.mintick
tMin = hour(time, TZ) * 60 + minute(time, TZ)
endMin = tMin + 5
inRth = tMin >= 570 and tMin < 960
// the CME index futures' half days (13:15 close): the Friday after Thanksgiving and Christmas Eve, out at the 13:10 open
dom = dayofmonth(time, TZ)
halfDay = (month(time, TZ) == 11 and dayofweek(time, TZ) == dayofweek.friday and dom >= 23 and dom <= 29) or (month(time, TZ) == 12 and dom == 24)
flatAt = halfDay ? 790 : 955   // the bar end (minutes from midnight) from which to be out: 13:10 or 15:55
isCheck = inRth and endMin >= 600 and endMin <= 900 and (endMin - 600) % 30 == 0
dayNum = int(math.floor((time - 18000000) / 86400000))   // the New York session's day (any RTH bar)

var hCloses = array.new_float(0)
var hDays = array.new_float(0)
var hGaps = array.new_float(0)
var hRanges = array.new_float(0)
var hBar0 = array.new_float(0)   // the complete sessions' 09:30 bar ranges
var float avgRange = na
var hMoves = array.new_float(0)   // NCH a session
var tMoves = array.new_float(NCH, na)
var sig = array.new_float(NCH, na)
var int tBars = 0
var float tClose = na
var int tDay = -1
var float dayOpen = na
var float tGap = na
var float tBar0 = na
var bool tNoOpen = false   // docs 164: the session's first bar is not 09:30: no trades, not in the history
var float dHi = na
var float dLo = na
var float vNum = 0.0
var float vDen = 0.0
var bool ready = false
var float prevC = na
var float sma = na
var int qty = 1
var float hwm = na          // the cushion guard: the high-water mark, today's cap and day stop
var int capToday = 3
var float dsToday = 0.0
var bool strongOnly = false
var bool gapToday = false
var float dayStartNet = 0.0
var int tradesToday = 0
var float hardRef = na
var float stopPx = na
var float tgtPx = na
var float entryPx = na
var bool beDone = false
var int leg = 0   // the open or pending position: 1 the band, 2 the gap trade
var int preDay = -1
var float preVol = 0.0
var int preBars = 0
var float atVol = na
var bool newsSkip = false
var float spike = na
if tMin >= 500 and tMin <= 510   // extended hours: the news spike's inputs (08:20, 08:25 and the 08:30 bar)
    if dayNum != preDay
        preDay := dayNum
        preVol := 0.0
        preBars := 0
        atVol := na
    if tMin < 510
        preVol += volume
        preBars += 1
    else
        atVol := volume

if inRth and dayNum != tDay
    if tDay >= 0 and tBars >= 76 and not tNoOpen   // only complete sessions count (and only with their 09:30 bar)
        array.push(hCloses, tClose)
        array.push(hDays, tDay)
        array.push(hGaps, tGap)
        array.push(hRanges, dHi - dLo)
        array.push(hBar0, tBar0)
        for k = 0 to NCH - 1
            array.push(hMoves, array.get(tMoves, k))
        if array.size(hCloses) > 60
            array.shift(hCloses)
            array.shift(hDays)
            array.shift(hGaps)
            array.shift(hRanges)
            array.shift(hBar0)
            for k = 0 to NCH - 1
                array.shift(hMoves)
    nH = array.size(hCloses)
    tDay := dayNum
    tBars := 0
    tNoOpen := tMin != 570
    dHi := high
    dLo := low
    dayOpen := open
    tBar0 := high - low
    tGap := nH > 0 ? open - array.get(hCloses, nH - 1) : na
    for k = 0 to NCH - 1
        array.set(tMoves, k, na)
    vNum := 0.0
    vDen := 0.0
    tradesToday := 0
    dayStartNet := strategy.netprofit
    gapToday := false
    ready := nH >= math.max(21, trendDays + 1)
    // a hole in the history: more than 5 weekdays without a complete session in the 14-session window (holidays and
    // half days leave at most 4; calendar days, the old test, blocked the Mondays after Thanksgiving and New Year)
    if ready and blockHole
        int wk = 0
        for dd = array.get(hDays, nH - 14) to dayNum - 1
            dow = (dd + 4) % 7   // 1970-01-01 (day 0) was a Thursday: 0 Sunday .. 6 Saturday
            if dow != 0 and dow != 6
                wk += 1
        if wk - 14 > 5
            ready := false
    if ready
        prevC := array.get(hCloses, nH - 1)
        float s = 0.0
        if trendDays > 0
            for j = nH - trendDays to nH - 1
                s += array.get(hCloses, j)
        sma := trendDays > 0 ? s / trendDays : na
        float rsum = 0.0
        for j = nH - 14 to nH - 1
            rsum += array.get(hRanges, j)
        avgRange := rsum / 14
        for k = 0 to NCH - 1
            // docs/STRATEGY_SEARCH.md 162: over the last 14 sessions that have this time's bar, if at least sigMin do
            float m = 0.0
            int cnt = 0
            for j = nH - 14 to nH - 1
                v = array.get(hMoves, j * NCH + k)
                if not na(v)
                    m += v
                    cnt += 1
            array.set(sig, k, cnt >= sigMin ? m / cnt : na)
        prof = startProfit + strategy.netprofit
        qty := fixedQty > 0 ? fixedQty : math.min(prof >= step3 ? 3 : prof >= step2 ? 2 : 1, maxQty)
        // the cushion guard: the floor trails the highest day-start balance by trailDD (stopping at the start
        // balance); under cushionGuard $ above it, 1 contract and a day stop of guardShare x the cushion
        bal = strategy.initial_capital + prof
        hwm := math.max(na(hwm) ? math.max(strategy.initial_capital, highestBal) : hwm, bal)
        cush = bal - math.min(hwm - trailDD, strategy.initial_capital)
        guarded = cushionGuard > 0 and cush < cushionGuard
        capToday := guarded ? 1 : maxQty
        strongOnly := cushionGuard > 0 and strongBelow > 0 and cush < strongBelow
        qty := math.min(qty, capToday)
        dsToday := guarded ? math.max(100, math.min(dayStop > 0 ? dayStop : 1e12, guardShare * cush)) : dayStop
        gapToday := gapLeg and (gapFrom <= 0 or prof >= gapFrom)
        spike := preDay == dayNum and preBars == 2 and preVol > 0 and not na(atVol) ? atVol / (preVol / 2) : na
        newsSkip := false
        if newsDays and not na(spike)
            if spike >= newsSkipLo and spike < newsSkipHi
                newsSkip := true
            else if spike >= newsBig and fixedQty == 0
                qty := math.min(qty + 1, capToday)

float vwapNow = na
if inRth
    dHi := math.max(dHi, high)
    dLo := math.min(dLo, low)
    tBars += 1
    vol = volume > 0 ? volume : 1.0
    vNum += (high + low + close) / 3 * vol
    vDen += vol
    vwapNow := vNum / vDen
    if isCheck
        array.set(tMoves, int((endMin - 600) / 30), math.abs(close / dayOpen - 1))
    tClose := close

pos = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
if pos == 0
    entryPx := na
if pos != 0 and leg == 1 and na(entryPx)   // the band entry filled at this bar's open
    entryPx := strategy.position_avg_price
    beDone := false
    tgtPx := tpAt > 0 ? strategy.position_avg_price + pos * math.round(tpAt * hardStop / pv / tk) * tk : na
bandId = pos > 0 ? "Long" : "Short"
// a trade still open outside regular hours (a half day's 13:15 close came before the 15:55 exit) or on a new session's
// first bar (a regular-hours chart): out now, never carried into the next session
carryOut = pos != 0 and (not inRth or tBars == 1)
if carryOut
    strategy.close_all(comment = "Session end")

if inRth and ready and not carryOut
    if pos != 0 and leg == 1 and endMin >= flatAt
        strategy.close(bandId, comment = "Session end")
    else if pos != 0 and leg == 2 and tMin >= 590
        strategy.close(pos > 0 ? "GapLong" : "GapShort", comment = "Gap exit")
    else if not (newsSkip and pos == 0)
        if tMin == 570 and gapToday and pos == 0 and array.size(hGaps) >= 15 and not na(tGap)
            float gs = 0.0
            bool gOk = true
            nG = array.size(hGaps)
            for j = nG - 14 to nG - 1
                gv = array.get(hGaps, j)
                if na(gv)
                    gOk := false
                else
                    gs += math.abs(gv)
            side = tGap > 0 ? 1 : -1
            // a 09:30 bar under gapBody x the average range puts the stop inside the noise (docs/STRATEGY_SEARCH.md, 28)
            // a wild open: the 09:30 bar's range over gapMaxBar x its 14-session average (docs/STRATEGY_SEARCH.md, 61)
            if gapMaxBar > 0
                float b0 = 0.0
                nB = array.size(hBar0)
                for j = nB - 14 to nB - 1
                    b0 += array.get(hBar0, j)
                if high - low > gapMaxBar * b0 / 14
                    gOk := false
            if gOk and math.abs(tGap) >= gapK * gs / 14 and side * (close - dayOpen) > 0 and side * (close - dayOpen) >= gapBody * avgRange
                e = close + side * tk
                dist = math.min(math.max(math.abs(e - dayOpen), 4 * tk), gapCap)
                gid = side > 0 ? "GapLong" : "GapShort"
                strategy.entry(gid, side > 0 ? strategy.long : strategy.short, qty)
                strategy.exit(gid + " stop", gid, stop = e - side * dist, comment = "Stop loss")
                leg := 2
        if pos != 0 and leg == 1 and beAt > 0 and not beDone and pos * (close - entryPx) >= beAt * hardStop / pv
            be = math.round_to_mintick(entryPx + pos * math.max(tk, bePlus))
            if pos * (be - stopPx) > 0
                stopPx := be
            beDone := true
        // the second step: a close ladAt hard stops up moves the stop to the entry + ladLock hard stops (docs 61)
        if pos != 0 and leg == 1 and ladAt > 0 and pos * (close - entryPx) >= ladAt * hardStop / pv
            lk = math.round_to_mintick(entryPx + pos * ladLock * hardStop / pv)
            if pos * (lk - stopPx) > 0
                stopPx := lk
        k = int((endMin - 600) / 30)
        sg = isCheck ? array.get(sig, k) : na
        if not na(sg)
            up = math.max(dayOpen, prevC) * (1 + sg)
            dn = math.min(dayOpen, prevC) * (1 - sg)
            bl = vwapStop ? math.max(up, vwapNow) : up
            bs = vwapStop ? math.min(dn, vwapNow) : dn
            if pos != 0 and leg == 1
                hardPx = hardRef - pos * hardStop / pv
                nw = math.round_to_mintick(pos > 0 ? math.max(bl, hardPx) : math.min(bs, hardPx))
                nw := pos > 0 ? math.max(nw, stopPx) : math.min(nw, stopPx)
                if pos * (close - nw) <= 0
                    strategy.close(bandId, comment = "Back inside")
                else
                    stopPx := nw
            else if pos == 0 and not tNoOpen and endMin <= lastEntry and endMin < flatAt and tradesToday < maxTrades and (dsToday <= 0 or strategy.netprofit - dayStartNet > -dsToday)
                want = close > up ? 1 : close < dn ? -1 : 0
                if want != 0 and vwapEntry and want * (close - vwapNow) <= 0
                    want := 0
                if want != 0 and trendDays > 0 and want * (close - sma) <= 0
                    want := 0
                if want != 0 and maxMove > 0 and endMin != 600 and want * (close - dayOpen) > maxMove * avgRange
                    want := 0
                if want != 0 and strongOnly and want * (close - (want > 0 ? up : dn)) < strongStretch * sg * (want > 0 ? math.max(dayOpen, prevC) : math.min(dayOpen, prevC))
                    want := 0   // the cushion guard's last tier: strong breaks only
                posR = dHi > dLo ? (close - dLo) / (dHi - dLo) : 0.5
                if want != 0 and rangePos > 0 and ((want > 0 and posR < rangePos) or (want < 0 and posR > 1 - rangePos))
                    want := 0
                if want != 0
                    hardRef := close + want * tk
                    hp = hardRef - want * hardStop / pv
                    stopPx := want > 0 ? math.max(bl, hp) : math.min(bs, hp)
                    if want * (hardRef - stopPx) <= 0   // VWAP on the wrong side of the fill: the band alone
                        stopPx := want > 0 ? math.max(up, hp) : math.min(dn, hp)
                    stopPx := math.round_to_mintick(stopPx)
                    tgtPx := na
                    nid = want > 0 ? "Long" : "Short"
                    // a close stretchAdd sigmas or more past the band: one more contract (docs/STRATEGY_SEARCH.md, 30)
                    refPx = want > 0 ? math.max(dayOpen, prevC) : math.min(dayOpen, prevC)
                    stretch = want * (close - (want > 0 ? up : dn)) / (sg * refPx)
                    q = stretchAdd > 0 and fixedQty == 0 and sg > 0 and stretch >= stretchAdd ? math.min(qty + 1, capToday) : qty
                    strategy.entry(nid, want > 0 ? strategy.long : strategy.short, q)
                    strategy.exit(nid + " exit", nid, stop = stopPx, comment = "Stop loss")
                    tradesToday += 1
                    leg := 1
                    entryPx := na
    if pos != 0 and leg == 1 and strategy.position_size != 0
        strategy.exit(bandId + " exit", bandId, stop = stopPx, limit = tgtPx, comment_loss = "Stop loss", comment_profit = "Profit target")

// the bands as level lines: each check's level held until the next check, broken between sessions (display only)
var float upBand = na
var float loBand = na
if inRth and tBars == 1
    upBand := na
    loBand := na
if isCheck and not na(array.get(sig, int((endMin - 600) / 30)))
    upBand := math.max(dayOpen, prevC) * (1 + array.get(sig, int((endMin - 600) / 30)))
    loBand := math.min(dayOpen, prevC) * (1 - array.get(sig, int((endMin - 600) / 30)))
plot(inRth ? upBand : na, "Upper band", color.teal, style = plot.style_linebr)
plot(inRth ? loBand : na, "Lower band", color.maroon, style = plot.style_linebr)

// docs/STRATEGY_SEARCH.md 172: what the chart's state is, as MnqCleanBand.cs's dashboard (no effect on the trades)
var table dash = table.new(position.top_right, 1, 1, bgcolor = color.gray)
if barstate.islast
    nHist = array.size(hCloses)
    string setup = "OK"
    if nHist < math.max(21, trendDays + 1)
        setup := "NOT READY: " + str.tostring(nHist) + " complete sessions, needs " + str.tostring(math.max(21, trendDays + 1)) + " (load more history)"
    else if not ready
        setup := "NO TRADING: the history has a hole"
    else if tNoOpen
        setup := "NO TRADING TODAY: no 09:30 bar"
    string news = "off"
    if newsDays
        news := na(spike) ? "n/a - turn on extended hours (ETH) so the news rule can read the 08:30 bars" : newsSkip ? str.tostring(spike, "#.#") + "x: no trades today" : str.tostring(spike, "#.#") + "x"
    string off = ""
    if ready
        for k = 0 to NCH - 1
            if na(array.get(sig, k))
                m = 600 + 30 * k
                off := off + (off == "" ? "" : ", ") + str.tostring(math.floor(m / 60)) + ":" + (m % 60 == 0 ? "00" : "30")
    table.cell(dash, 0, 0, "MNQ Clean Band | Setup: " + setup + " | news " + news + (off == "" ? "" : " | check(s) off today: " + off), text_color = color.white, text_size = size.small)


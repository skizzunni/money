//@version=6
// MGC Overnight Carry: gold's overnight move carried on into the COMEX morning (docs/STRATEGY_SEARCH.md, 37). The
// same rules as ninjatrader/Strategies/MgcOvernightCarry.cs; research/zoo/mk_search.py carry is the reference both are
// tested against. For the days MNQ does not trade; it runs beside the MNQ Clean Noise-Band on the same account.
// 5-minute MGC chart with extended hours (the overnight session and the 13:25 bar), New York times:
//   * the move = the 08:20 bar's open less the prior session's 13:25 bar close;
//   * at least 1.5x the last 14 sessions' average |move|, and the bars from 08:20 to 08:35 closing its way (the 08:30
//     bar's close against the 08:20 open): in at the next open, the stop a tick past the 08:20 open;
//   * out at the 13:25 bar's close (filled at 13:30; a gap in the bars: the first bar from 13:25 on); a trade still
//     open when the next trading day starts (a holiday's early close) goes out on its first bar; one trade a day;
//   * 1 / 2 / 3 contracts from +$0 / +$2,000 / +$3,500; no trade while under $1,500 above the trailing floor.
// A session counts in the 14 only with at least 180 five-minute bars (a full gold session has 276).
strategy("MGC Overnight Carry", overlay = true, initial_capital = 50000, default_qty_type = strategy.fixed,
     default_qty_value = 1, pyramiding = 0, margin_long = 0, margin_short = 0,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62, slippage = 1)

const string TZ = "America/New_York"

kMove = input.float(1.5, "Overnight move at least this many 14-session averages", minval = 0.1, step = 0.25)
confirm = input.int(15, "Minutes from 08:20 that must close its way", minval = 5, maxval = 120, step = 5)
openAt = input.int(500, "Session open, minutes from midnight New York (500 = 08:20)", minval = 0, maxval = 1439)
exitAt = input.int(810, "Out at, minutes from midnight New York (810 = 13:30)", minval = 0, maxval = 1439)
maxQty = input.int(3, "Most contracts", minval = 1, maxval = 3)
fixedQty = input.int(0, "Fixed contracts (0 = the profit steps)", minval = 0, maxval = 50)
step2 = input.float(2000, "2 contracts from this profit $", minval = 0)
step3 = input.float(3500, "3 contracts from this profit $", minval = 0)
startProfit = input.float(0, "Profit already made at the start $")
cushionGuard = input.float(1500, "Cushion guard: no trade below this $ above the floor (0 = off)", minval = 0)
trailDD = input.float(2000, "The account's trailing drawdown $", minval = 100)
highestBal = input.float(0, "Highest end-of-day balance so far $ (0 = the start balance)", minval = 0)

tk = syminfo.mintick
tMin = hour(time, TZ) * 60 + minute(time, TZ)
later = time + 21600000   // + 6 hours: the trading day runs 18:00 the evening before to 17:00
tDay = year(later, TZ) * 10000 + month(later, TZ) * 100 + dayofmonth(later, TZ)

var moves = array.new_float(0)   // the kept sessions' moves, oldest first
var float lastSettle = na        // the last kept session's 13:25 close
var int curDay = -1
var int dBars = 0
var float dOpen = na
var float dSettle = na
var float dMove = na
var bool traded = false
var int qty = 1
var int posDay = -1
var float hwm = na
var bool guarded = false

if tDay != curDay
    if curDay >= 0 and dBars >= 180   // the session that ended: kept only when complete
        array.push(moves, dMove)
        if array.size(moves) > 40
            array.shift(moves)
        lastSettle := dSettle
    curDay := tDay
    dBars := 0
    dOpen := na
    dSettle := na
    dMove := na
    traded := false
    prof = startProfit + strategy.netprofit
    qty := fixedQty > 0 ? fixedQty : math.min(prof >= step3 ? 3 : prof >= step2 ? 2 : 1, maxQty)
    bal = strategy.initial_capital + prof   // the cushion guard: no trade under cushionGuard $ above the trailing floor
    hwm := math.max(na(hwm) ? math.max(strategy.initial_capital, highestBal) : hwm, bal)
    guarded := cushionGuard > 0 and bal - math.min(hwm - trailDD, strategy.initial_capital) < cushionGuard
dBars += 1
if tMin == openAt
    dOpen := open
    dMove := open - lastSettle
if tMin == exitAt - 5
    dSettle := close

pos = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
if pos != 0 and posDay != tDay   // the session ended before the exit (a holiday's early close): out now
    strategy.close_all(comment = "Session end")
else if pos != 0 and tMin >= exitAt - 5 and tMin < 1020
    strategy.close_all(comment = "Time exit")
else if pos == 0 and tMin == openAt + confirm - 5 and not traded and not guarded and not na(dMove) and array.size(moves) >= 14
    float s = 0.0
    bool ok = true
    n = array.size(moves)
    for j = n - 14 to n - 1
        m = array.get(moves, j)
        if na(m)
            ok := false
        else
            s += math.abs(m)
    side = dMove > 0 ? 1 : -1
    if ok and math.abs(dMove) >= kMove * s / 14 and side * (close - dOpen) > 0
        stp = math.round_to_mintick(dOpen - side * tk)
        id = side > 0 ? "CarryLong" : "CarryShort"
        strategy.entry(id, side > 0 ? strategy.long : strategy.short, qty)
        strategy.exit(id + " stop", id, stop = stp, comment = "Stop loss")
        traded := true
        posDay := tDay

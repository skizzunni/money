//@version=6
// MNQ Noise-Area Momentum
// ------------------------------------------------------------------
// Intraday momentum from Zarattini, Aziz & Barbon (2024), "Beat the Market",
// with the paper's settings. Every half hour from 10:00 to 15:30 New York time:
//   * flat:  BUY if price closed above the noise area, SELL if below it
//   * in a trade: a stop order rests just past the noise line (0.24 noise units: the distance price
//     typically overshoots the line before resuming, from 16 years of data) and moves with the line
//     ("Resting stop", the default); or, with "Half-hour check", EXIT when a check closes back inside
//     the lines (REVERSE if through the other side)
// Everything is closed at the 16:00 close. No trades until 14 full sessions are on the chart,
// and none on the dates in "Don't trade on these dates" (holidays and half days by default).
//
// Noise area for each half-hour mark = the day's open (and previous close) plus/minus the
// average distance price has moved from the 09:30 open by that time over the last 14 sessions.
//
// Tested on 16 years of Nasdaq-100 data: see docs/RESULTS.md. It has an edge, but it loses
// often and has losing years. With the resting stop it passed about 6 in 10 historical $25K /
// $1,500 evaluations on 1 MNQ, and about 84% of $100K ones. It does NOT "never lose".
//
// Chart: MNQ1! (or the front-month MNQ contract), 5 minutes (1, 5, 10, 15 or 30 work).
// The rules are the same as the Python reference in mnqbot/noise.py.
// ------------------------------------------------------------------
strategy("MNQ Noise-Area Momentum", shorttitle = "Noise-Mom", overlay = true,
     initial_capital = 25000, currency = currency.USD,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62,
     slippage = 1, margin_long = 0, margin_short = 0, max_bars_back = 500, max_labels_count = 500)

const string TZ = "America/New_York"
const int N_CHECKS = 12   // 10:00, 10:30, ..., 15:30
const int FIRST_CHECK = 600
const int LAST_CHECK = 930
const int RTH_OPEN = 570
const int RTH_CLOSE = 960

// ── Inputs
grpT = "Trading"
lookback = input.int(14, "Sessions in the noise average", minval = 2, maxval = 60, group = grpT)
qty      = input.int(1, "Contracts", minval = 1, maxval = 30, group = grpT,
     tooltip = "1 MNQ is already large for a $1,500 drawdown: see docs/RESULTS.md")
skipDates = input.string("2026-01-01,2026-01-19,2026-02-16,2026-04-03,2026-05-25,2026-06-19,2026-07-03,2026-09-07,2026-11-26,2026-11-27,2026-12-24,2026-12-25,2027-01-01,2027-01-18,2027-02-15,2027-03-26,2027-05-31,2027-06-18,2027-07-05,2027-09-06,2027-11-25,2027-11-26,2027-12-24",
     "Don't trade on these dates", group = grpT,
     tooltip = "YYYY-MM-DD, comma separated. Pre-filled with the 2026-2027 US market holidays and half days, when MNQ trades a short session. Add news days if you like.")
exitMode = input.string("Resting stop at the line", "Exit", options = ["Resting stop at the line", "Half-hour check"], group = grpT,
     tooltip = "Resting stop: once in a trade, a stop order sits at the noise line and moves with it at every half hour. Tested on 16 years: smaller worst days and better evaluation odds. Half-hour check: the paper's rule, exit only when a half-hour check closes back inside the lines.")
useStop = exitMode == "Resting stop at the line"
stopBuf = input.float(0.24, "Stop distance past the line, in noise units", minval = 0, maxval = 2, step = 0.01, group = grpT,
     tooltip = "0 puts the stop exactly on the line. 0.24 is how far price typically overshoots the line before resuming, measured on 2011-2018; it cut whipsaw stop-outs and raised profit per day on every later period. See docs/RESULTS.md.")
grpV = "Display"
showBands = input.bool(true, "Show noise area", group = grpV)
showLabels = input.bool(true, "Show BUY / SELL / EXIT labels", group = grpV)
shadeTrades = input.bool(true, "Shade the chart while in a trade", group = grpV)
showDash  = input.bool(true, "Show dashboard", group = grpV)

// ── Clock
barMin  = int(timeframe.in_seconds() / 60)
validTf = barMin >= 1 and 30 % barMin == 0
tMin    = hour(time, TZ) * 60 + minute(time, TZ)
endMin  = tMin + barMin   // bar close, minutes after midnight
inRth   = tMin >= RTH_OPEN and endMin <= RTH_CLOSE
isCheck = validTf and inRth and endMin >= FIRST_CHECK and endMin <= LAST_CHECK and (endMin - FIRST_CHECK) % 30 == 0

hhmmText(int mins) => str.tostring(int(mins / 60)) + ":" + (mins % 60 == 0 ? "00" : "30")
px(float x) => str.tostring(x, format.mintick)
// A signal label on the candle that triggered it: below the candle for buys, above for sells.
mark(string txt, bool below, color c) =>
    if showLabels
        label.new(bar_index, below ? low : high, txt, yloc = below ? yloc.belowbar : yloc.abovebar,
             style = below ? label.style_label_up : label.style_label_down, color = c, textcolor = color.white, size = size.normal)

// ── State
var float dayOpen = na
var float prevClose = na
var float lastRthClose = na
var float ub = na
var float lb = na
var float sig = na   // this check's noise (sigma), which sets the stop distance
var moves = array.new_float(lookback * N_CHECKS, na)   // ring buffer: one row of 12 moves per session
var today = array.new_float(N_CHECKS, na)
var int filled = 0
var int slot = 0
var bool skipToday = false
var string lastSignal = "-"
var int prevClosed = 0   // closed trades at the end of the previous bar

// ── The resting stop filled during this bar (the broker did it; show it). A trade can open and
// close inside one bar, so look at the closed-trade count, not the position.
lastTrade = strategy.closedtrades - 1
stopFired = useStop and strategy.closedtrades > prevClosed and strategy.closedtrades.exit_comment(lastTrade) == "Back inside"
if stopFired
    mark("EXIT", strategy.closedtrades.size(lastTrade) < 0, color.gray)
    lastSignal := "EXIT (line touched) @ " + px(strategy.closedtrades.exit_price(lastTrade))

// ── A session that ended early (half day, data gap): get flat
if strategy.position_size != 0 and (not inRth or tMin == RTH_OPEN)
    mark("EXIT NOW", strategy.position_size < 0, color.orange)
    lastSignal := "EXIT NOW (session ended)"
    strategy.close_all(comment = "Session ended", immediately = true)
    alert("EXIT NOW: the session ended with a position open. Close your MNQ position at market.", alert.freq_once_per_bar_close)

// ── New day at the 09:30 bar
if tMin == RTH_OPEN
    prevClose := lastRthClose
    dayOpen := open
    ub := na
    lb := na
    sig := na
    skipToday := str.contains(skipDates, str.format_time(time, "yyyy-MM-dd", TZ))
    for k = 0 to N_CHECKS - 1
        array.set(today, k, na)
if inRth
    lastRthClose := close

// ── Half-hour checks
longPlaced = false
shortPlaced = false
if isCheck and not na(dayOpen)
    k = int((endMin - FIRST_CHECK) / 30)
    array.set(today, k, math.abs(close / dayOpen - 1))
    if filled >= lookback and not na(prevClose)
        float s = 0.0
        for d = 0 to lookback - 1
            s += array.get(moves, d * N_CHECKS + k)
        sigma = s / lookback
        sig := sigma
        ub := math.max(dayOpen, prevClose) * (1 + sigma)
        lb := math.min(dayOpen, prevClose) * (1 - sigma)
        nextCheck = k == N_CHECKS - 1 ? "the 16:00 close" : hhmmText(endMin + 30)
        longStopNow = ub * (1 - stopBuf * sig)
        shortStopNow = lb * (1 + stopBuf * sig)
        holdLong = useStop ? "Put a stop at " + px(longStopNow) + " (just below the upper line), and move it when the line moves, at every half hour." :
             "Hold until a half-hour check closes back below the upper line, or the 16:00 close."
        holdShort = useStop ? "Put a stop at " + px(shortStopNow) + " (just above the lower line), and move it when the line moves, at every half hour." :
             "Hold until a half-hour check closes back above the lower line, or the 16:00 close."
        pos = strategy.position_size
        inPosStop = useStop and pos != 0   // exits are the resting stop's job
        if not skipToday
            if not inPosStop and pos > 0 and close < ub
                if close < lb
                    strategy.entry("Short", strategy.short, qty, comment = "Reverse short")
                    mark("REVERSE\nSELL " + str.tostring(2 * qty), false, color.red)
                    lastSignal := "REVERSE to short " + hhmmText(endMin) + " @ " + px(close)
                    alert("REVERSE: exit the long and SELL " + str.tostring(qty) + " MNQ at market now. Price " + px(close) +
                         " is below the noise area (lower " + px(lb) + "). Next check " + nextCheck + ".", alert.freq_once_per_bar_close)
                else
                    strategy.close("Long", comment = "Back inside")
                    mark("EXIT", false, color.gray)
                    lastSignal := "EXIT long " + hhmmText(endMin) + " @ " + px(close)
                    alert("EXIT LONG at market now. Price " + px(close) + " closed back below the upper line (" + px(ub) +
                         "). Stay flat until the next signal.", alert.freq_once_per_bar_close)
            else if not inPosStop and pos < 0 and close > lb
                if close > ub
                    strategy.entry("Long", strategy.long, qty, comment = "Reverse long")
                    mark("REVERSE\nBUY " + str.tostring(2 * qty), true, color.green)
                    lastSignal := "REVERSE to long " + hhmmText(endMin) + " @ " + px(close)
                    alert("REVERSE: exit the short and BUY " + str.tostring(qty) + " MNQ at market now. Price " + px(close) +
                         " is above the noise area (upper " + px(ub) + "). Next check " + nextCheck + ".", alert.freq_once_per_bar_close)
                else
                    strategy.close("Short", comment = "Back inside")
                    mark("EXIT", true, color.gray)
                    lastSignal := "EXIT short " + hhmmText(endMin) + " @ " + px(close)
                    alert("EXIT SHORT at market now. Price " + px(close) + " closed back above the lower line (" + px(lb) +
                         "). Stay flat until the next signal.", alert.freq_once_per_bar_close)
            else if pos == 0 and close > ub
                strategy.entry("Long", strategy.long, qty, comment = "Above noise")
                longPlaced := true
                mark("BUY " + str.tostring(qty), true, color.green)
                lastSignal := "BUY " + hhmmText(endMin) + " @ " + px(close)
                alert("BUY " + str.tostring(qty) + " MNQ at market now. Price " + px(close) + " is above the noise area (upper " +
                     px(ub) + "). " + holdLong + " Next check " + nextCheck + ".", alert.freq_once_per_bar_close)
            else if pos == 0 and close < lb
                strategy.entry("Short", strategy.short, qty, comment = "Below noise")
                shortPlaced := true
                mark("SELL " + str.tostring(qty), false, color.red)
                lastSignal := "SELL " + hhmmText(endMin) + " @ " + px(close)
                alert("SELL " + str.tostring(qty) + " MNQ at market now. Price " + px(close) + " is below the noise area (lower " +
                     px(lb) + "). " + holdShort + " Next check " + nextCheck + ".", alert.freq_once_per_bar_close)

// ── The resting stop: just past the current line, re-placed every bar so it moves with the line
longStop = ub * (1 - stopBuf * sig)
shortStop = lb * (1 + stopBuf * sig)
if useStop and inRth and not na(ub)
    if strategy.position_size > 0 or longPlaced
        strategy.exit("Long exit", "Long", stop = longStop, comment = "Back inside",
             alert_message = "EXIT LONG: price hit the stop at " + px(longStop) + " (just below the upper line " + px(ub) + "). Your stop should have filled. If you had no stop in, exit at market now.")
    if strategy.position_size < 0 or shortPlaced
        strategy.exit("Short exit", "Short", stop = shortStop, comment = "Back inside",
             alert_message = "EXIT SHORT: price hit the stop at " + px(shortStop) + " (just above the lower line " + px(lb) + "). Your stop should have filled. If you had no stop in, exit at market now.")

// ── 16:00: flat, and store today's moves if the session was complete
if inRth and endMin == RTH_CLOSE
    if strategy.position_size != 0
        mark("FLAT", strategy.position_size < 0, color.gray)
        lastSignal := "FLAT 16:00 @ " + px(close)
        strategy.close_all(comment = "16:00 close", immediately = true)
        alert("FLAT: close your MNQ position at market now (16:00 close).", alert.freq_once_per_bar_close)
    if not na(dayOpen)
        complete = true
        for k = 0 to N_CHECKS - 1
            if na(array.get(today, k))
                complete := false
        if complete
            for k = 0 to N_CHECKS - 1
                array.set(moves, slot * N_CHECKS + k, array.get(today, k))
            slot := (slot + 1) % lookback
            filled += 1
    dayOpen := na

// ── Drawing
plot(showBands and inRth ? ub : na, "Upper noise line", color.teal, 2, plot.style_linebr)
plot(showBands and inRth ? lb : na, "Lower noise line", color.maroon, 2, plot.style_linebr)
bgcolor(shadeTrades and strategy.position_size > 0 ? color.new(color.teal, 88) : shadeTrades and strategy.position_size < 0 ? color.new(color.maroon, 88) : na)

var table dash = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))
if showDash and (barstate.islastconfirmedhistory or barstate.isrealtime)
    pos = strategy.position_size
    status = not validTf ? "Use a 1/5/10/15/30 min chart" : filled < lookback ? "Building history" : pos > 0 ? "LONG" : pos < 0 ? "SHORT" : skipToday and inRth ? "No trades today (date list)" : "Flat"
    statusColor = pos > 0 ? color.lime : pos < 0 ? color.red : color.white
    nextText = not inRth or endMin >= LAST_CHECK ? "10:00 next session" : endMin < FIRST_CHECK ? "10:00" : hhmmText(endMin - (endMin - FIRST_CHECK) % 30 + 30)
    closed = strategy.closedtrades
    wins = strategy.wintrades
    table.cell(dash, 0, 0, "MNQ Noise Momentum", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 0, status, text_color = statusColor, text_size = size.small)
    table.cell(dash, 0, 1, "Sessions of history", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 1, str.tostring(math.min(filled, lookback)) + " / " + str.tostring(lookback), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 2, "Upper / lower now", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 2, na(ub) or not inRth ? "next lines at 10:00" : px(ub) + " / " + px(lb), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 3, "Next check", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 3, nextText, text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 4, "Backtest trades / win %", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 4, str.tostring(closed) + " / " + (closed > 0 ? str.tostring(100 * wins / closed, "#") + "%" : "-"), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 6, "Last signal", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 6, lastSignal, text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 7, "Exit rule", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 7, useStop ? "stop " + str.tostring(stopBuf) + " noise units past the line" : "half-hour check", text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 8, "Your stop", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 8, not useStop ? "-" : pos > 0 ? px(longStop) : pos < 0 ? px(shortStop) : "-", text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 5, "Backtest net", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 5, (strategy.netprofit < 0 ? "-$" : "$") + str.tostring(math.abs(strategy.netprofit), "#,##0.00"),
         text_color = strategy.netprofit >= 0 ? color.lime : color.red, text_size = size.small)
prevClosed := strategy.closedtrades
